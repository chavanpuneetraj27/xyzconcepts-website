# XYZconcepts — Apache configuration for Hostinger shared hosting.
# Copied verbatim into dist/ by Vite and served from public_html.

# ── 1. Canonical host and scheme ────────────────────────────────────────────
# Exactly one URL must serve each page or Google splits ranking signals between
# duplicates. Canonical form is https://xyzconcepts.com (no www).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. HTTP_HOST is checked too so this is a no-op on localhost.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Strip www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Strip index.html from URLs so /about/index.html never competes with /about.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # Collapse duplicate trailing slashes.
  RewriteCond %{REQUEST_URI} ^(.*)//+(.*)$
  RewriteRule . %1/%2 [R=301,L]

  # ── 2. Routing ────────────────────────────────────────────────────────────
  # Existing files win outright (JS, CSS, images, sitemap.xml, robots.txt).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Each route was pre-rendered to <route>/index.html by scripts/postbuild.mjs.
  # Serve that file directly for the clean URL, so /about returns the About
  # page's own title, description, canonical and JSON-LD in the raw HTML —
  # with no redirect hop, and no trailing slash added.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([^.]+?)/?$ /$1/index.html [L]

  # Deliberately NO catch-all rewrite to the SPA shell. An unknown path is a
  # genuine 404 and must answer with status 404, not a 200 containing 404 text
  # (a "soft 404" — Google treats those as a quality problem). ErrorDocument
  # below serves the branded 404 page, which still boots the app.
</IfModule>

# mod_dir would answer /about with a 301 to /about/. The rule above already
# serves it, so that redirect is pure latency.
<IfModule mod_dir.c>
  DirectorySlash Off
  DirectoryIndex index.html
</IfModule>

ErrorDocument 404 /404.html

# ── 3. Compression ──────────────────────────────────────────────────────────
# Text assets are 3–6x smaller over the wire; directly improves LCP.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    application/ld+json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    application/ld+json image/svg+xml application/manifest+json
</IfModule>

# ── 4. Caching ──────────────────────────────────────────────────────────────
# Vite fingerprints everything in /assets, so those are immutable for a year.
# HTML must never be cached hard or visitors get stale pages after a deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType application/xml               "access plus 1 hour"
  ExpiresByType text/plain                    "access plus 1 day"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|png|jpe?g|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # ── 5. Security headers ───────────────────────────────────────────────────
  # Not ranking factors on their own, but HTTPS hygiene is, and these cost
  # nothing on a static site.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header unset X-Powered-By
</IfModule>

# ── 6. MIME types ───────────────────────────────────────────────────────────
# Some Hostinger images ship an Apache without these, which breaks WebP
# delivery and makes the manifest download instead of parse.
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType image/svg+xml               .svg
  AddType application/manifest+json   .webmanifest
  AddType application/ld+json         .jsonld
  AddType font/woff2                  .woff2
  AddCharset UTF-8                    .html .css .js .xml .json .txt
</IfModule>

# ── 7. Misc ─────────────────────────────────────────────────────────────────
Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
